# Kopiere diese Datei nach .env (lokal) bzw. trage die Werte bei Vercel unter
# Settings -> Environment Variables ein. Niemals echte Schlüssel committen.

# Öffentliche Basis-URL des Shops (ohne Schrägstrich am Ende)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (z. B. Neon oder Vercel Postgres)
DATABASE_URL=postgresql://user:pass@localhost:5432/nadir

# Stripe (Dashboard -> Entwickler -> API-Schlüssel)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# "true", sobald Stripe Tax im Dashboard eingerichtet ist (Preise bleiben brutto)
STRIPE_AUTOMATIC_TAX=false

# Admin-Zugang
ADMIN_PASSWORD=bitte-ein-langes-passwort-setzen
# Zufälliger String mit mind. 32 Zeichen, z. B.: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# E-Mails über Resend (resend.com). Ohne Schlüssel werden Mails nur ins Log geschrieben.
RESEND_API_KEY=
EMAIL_FROM="Nadir Parfums <bestellung@deine-domain.at>"
# Empfänger für Kontaktformular und Bestell-Benachrichtigungen
SHOP_INBOX=office@deine-domain.at

# Bild-Upload im Admin (Vercel -> Storage -> Blob)
BLOB_READ_WRITE_TOKEN=

# Google Analytics 4 (wird erst nach Cookie-Zustimmung geladen)
NEXT_PUBLIC_GA_ID=
